# Data and runtime state live outside git (junction to the archive repo).
# Anchored: only the ROOT data/ is runtime. An unanchored "data/" also matched
# source packages such as quantdesk/data/, silently keeping 11 tracked-source
# files out of the repository.
/data/
state/
results/
reports/
logs/
dist/
# Charter §6 attic: retired runtime artifacts kept for 20 trading days before
# deletion. Never source; never committed.
/attic/

__pycache__/
*.pyc
.pytest_cache/
.venv/
.quantdesk_test_tmp/
test_runtime/
*.tmp
tmp_factor_out.txt
tmp_factor_err.txt

# pytest --basetemp scratch trees and local junit/report artifacts
_tmp_*/
# Root-level scratch output from ad-hoc shell/agent probes; never source.
/_tmp_*.txt
_r4_*.xml
agent_workspace/
.pytest_tmp*/
.mypy_cache/
.ruff_cache/
.tmp/
.tmp_tests/
# tests/_artifacts contains tiny deterministic fixtures that must remain
# source-controlled. Runtime artifacts belong under test_runtime/ instead.
*_verify.json
*_cli_verify.json
*.log
*.bak
*.py[cod]
*.db-shm
*.db-wal
*.zip

# Local configuration and credentials. These are per-machine, never source:
# tracking config/llm_config.json would silently commit an API key the moment
# somebody fills one in.
config.local.yaml
config/llm_config.json
config/provider_secrets.json
config/parameter_sensitivity.json
# opencode's per-machine provider config: its provider block is where an API key goes.
opencode.jsonc

# Data subtrees. data/ above already covers these; listed explicitly because the
# clean-zip and hygiene governance tests assert the specific paths.
data/raw/
data/daily/
data/features/
data/news/
data/cache/
data/universe/
data/intraday/
data/update_staging/
data/vendor_staging/
data/test_runtime/
data/sector_history/
data/tracking/
data/metadata/*.csv
data/benchmark/*.csv
data/.locks/
data/quantdesk.db
/quantdesk.db

# Editor / tool state
.vscode/
.claude/
.codex/
.workbuddy/
.worktrees/
screenshots/
build/
*.spec
external_refs/

# Secrets
*.env
llm.env

# User's product governance documents. These are the USER's tool to keep
# Agents aligned with the approved product goals. They are intentionally
# local-only: they are not project source, not to be committed, synced,
# or included in any clean zip or release export.
docs/product/

# --- Strict Sanitized Mirror Exclusions ---
/config/
/data/
/state/
/logs/
/results/
/reports/
/docs/internal/
/docs/learning_journal.md
/STATUS.md
opencode.jsonc
.env
.env.*
*secret*
*secrets*
*.key
*.pem
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
!docs/screenshots/
!docs/screenshots/*.png
