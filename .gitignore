# tests/_artifacts contains tiny deterministic fixtures that must remain
# source-controlled. Runtime artifacts belong under test_runtime/ instead.
*_verify.json
*_cli_verify.json
*.log
*.bak
*.py[cod]
*.db-shm
*.db-wal
*.zip

# Local configuration and credentials. These are per-machine, never source:
# tracking config/llm_config.json would silently commit an API key the moment
# somebody fills one in.
config.local.yaml
config/llm_config.json
config/provider_secrets.json
config/parameter_sensitivity.json

